# ============================================================================
# ROOT .gitignore — MyApp WebApp
# ============================================================================

# ---- OS generated files ----
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- Visual Studio ----
.vs/
*.suo
*.user
*.userossscache
*.sln.docstates

# ---- VS Code ----
# Uncomment if you don't want to share VS Code settings
# .vscode/

# ---- JetBrains Rider / IntelliJ ----
.idea/

# ---- Vite cache ----
.vite/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Node ----
node_modules/

# ---- .NET build output ----
bin/
obj/

# ---- Frontend build output ----
dist/
build/

# ---- Environment files with secrets ----
.env.local
.env.*.local
appsettings.Development.json

# ---- TypeScript build info ----
*.tsbuildinfo

# ---- Generated knowledge and model artifacts (never committed) ----
/artifacts/
/training/out/
/models/*/weights/
src/frontend/public/help/
src/frontend/public/models/

# ---- Local runtime data ----
/data/
/logs/
src/backend/MyApp.WebApi/logs/
src/support/MyApp.Monitor/data/

# ---- Python ----
.venv/
__pycache__/
*.pyc

# ---- Test caches ----
.pytest_cache/

# ---- Docker (compose.yaml): the owner's settings and extra backend settings ----
.env
backend.local.env

# ---- Model weights: never in the repository (the lock file and model cards are the references) ----
*.gguf
*.onnx
*.onnx_data
*.safetensors
*.bin.index.json
*.pt
*.pth
/models/**/weights/
/models/**/*.gguf

# ---- Temporary execution plans (CLAUDE.md): never committed ----
executionplan_temp*.md
