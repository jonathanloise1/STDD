{
	"name": "myapp",
	"version": "0.1.0",
	"description": "MyApp web frontend: React, TypeScript and Vite.",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"start": "vite",
		"build": "tsc -b && vite build",
		"build:dev": "vite build --mode development",
		"build:prod": "vite build --mode production",
		"preview": "vite preview",
		"test": "vitest",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"translate:validate": "node scripts/translations/validate.cjs",
		"manual:generate": "node --disable-warning=ExperimentalWarning scripts/manual/generate.ts",
		"manual:check": "node --disable-warning=ExperimentalWarning scripts/manual/check.ts",
		"help:build": "node --disable-warning=ExperimentalWarning scripts/help/build.ts",
		"help:retrieve": "node --disable-warning=ExperimentalWarning scripts/help/retrieve.ts",
		"help:bench": "node --disable-warning=ExperimentalWarning scripts/help/bench.ts",
		"help:gaps": "node --disable-warning=ExperimentalWarning scripts/help/gaps.ts"
	},
	"dependencies": {
		"@azure/msal-browser": "^4.11.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@huggingface/transformers": "4.3.2",
		"axios": "^1.21.1",
		"axios-retry": "^4.5.0",
		"bootstrap": "^5.3.3",
		"classnames": "^2.5.1",
		"i18next": "^23.16.3",
		"i18next-browser-languagedetector": "^8.0.0",
		"i18next-http-backend": "^4.0.10",
		"jwt-decode": "^4.0.0",
		"lucide-react": "^1.60.0",
		"react": "^19.2.4",
		"react-bootstrap": "^2.10.10",
		"react-dom": "^19.2.4",
		"react-i18next": "^15.1.0",
		"react-router-dom": "^7.18.5",
		"react-toastify": "^10.0.6"
	},
	"devDependencies": {
		"@csstools/css-parser-algorithms": "^4.0.2",
		"@csstools/css-tokenizer": "^4.0.2",
		"@eslint/compat": "^1.2.1",
		"@eslint/js": "^9.28.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.6.2",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.5.2",
		"@types/node": "^22.7.9",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript-eslint/parser": "8.33.1",
		"@vitejs/plugin-react": "^4.3.4",
		"eslint": "^9.28.0",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-jsx-a11y": "^6.10.1",
		"eslint-plugin-prettier": "^5.2.1",
		"eslint-plugin-react": "^7.37.2",
		"eslint-plugin-react-hooks": "^5.0.0",
		"globals": "^15.11.0",
		"jsdom": "^28.1.0",
		"prettier": "^3.3.3",
		"sass": "^1.80.4",
		"typescript": "^5.6.0",
		"typescript-eslint": "^8.33.1",
		"vite": "^6.4.6",
		"vitest": "^5.1.0"
	},
	"overrides": {
		"@typescript-eslint/typescript-estree": {
			"minimatch": ">=9.0.7"
		}
	}
}
