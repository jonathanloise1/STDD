{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MyApp": {
    "Cors": {
      "AllowedOrigins": [ "http://localhost:3147", "https://localhost:3147" ]
    },
    "Logging": {
      "File": {
        "Enabled": false,
        "Directory": "logs",
        "FilePrefix": "myapp-api",
        "MaxFileSizeMB": 100,
        "RetainedFiles": 14,
        "MinimumLevel": "Information"
      }
    },
    "Help": {
      "PackDirectory": "",
      "Gaps": {
        "Enabled": true,
        "RetentionDays": 90
      }
    },
    "Models": {
      "LockPath": ""
    },
    "Assistant": {
      "Order": "browser-first",
      "Browser": {
        "Enabled": true,
        "ModelBaseUrl": "/models/assistant/",
        "MinTokensPerSecond": 8,
        "AskBeforeDownloadMb": 100,
        "TimeoutSeconds": 20
      },
      "Server": {
        "Enabled": false,
        "Endpoint": "http://127.0.0.1:8091",
        "TimeoutSeconds": 20,
        "MaxConcurrent": 2,
        "QueueTimeoutSeconds": 5
      }
    }
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "qualified.domain.name",
    "TenantId": "22222222-2222-2222-2222-222222222222",
    "ClientId": "11111111-1111-1111-11111111111111111",
    "Scopes": "access_as_user",
    "CallbackPath": "/signin-oidc"
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  }
}
