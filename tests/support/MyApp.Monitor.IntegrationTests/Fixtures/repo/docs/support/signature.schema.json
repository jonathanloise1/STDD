{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "signature.schema.json",
  "title": "Signature record",
  "description": "One record of the compiled signature table (signatures.json in the operations pack). Generated by 'pack build', never written by hand. Defined in docs/guidelines/operations.md section 5.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "kind", "match", "area", "user_story", "test_case", "severity", "message", "call_site", "runbook", "rate",
    "fingerprint_by", "cause_category", "status", "fixed_in", "noise", "rule_checks", "history"
  ],
  "properties": {
    "id": { "type": "string", "maxLength": 100, "description": "The log key (keyed) or the template id (template)" },
    "kind": { "type": "string", "enum": ["keyed", "template"] },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["log_key", "template_id", "event_name", "category", "exception_type", "top_frame", "template"],
      "properties": {
        "log_key": { "type": ["string", "null"], "pattern": "^[a-z]{2,8}\\.[a-z]{2,12}\\.[a-z]+(_[a-z]+)*$" },
        "template_id": { "type": ["string", "null"], "pattern": "^t-[0-9a-f]{12}$" },
        "event_name": { "type": ["string", "null"], "maxLength": 100 },
        "category": { "type": ["string", "null"], "maxLength": 300 },
        "exception_type": { "type": ["string", "null"], "maxLength": 300 },
        "top_frame": { "type": ["string", "null"], "maxLength": 300 },
        "template": { "type": ["string", "null"], "maxLength": 300 }
      }
    },
    "area": { "type": ["string", "null"], "pattern": "^[a-z]+(-[a-z]+)*$" },
    "user_story": { "type": ["string", "null"], "pattern": "^US-[A-Z]{2,8}-\\d{2}$" },
    "test_case": { "type": ["string", "null"], "pattern": "^[A-Z]{2,8}-[A-Z]{2,12}-\\d{3}$" },
    "severity": { "type": "string", "enum": ["Information", "Warning", "Error", "Critical"] },
    "message": { "type": ["string", "null"], "maxLength": 300, "description": "Observable trace Message without quotes; null for template signatures and for 'None'" },
    "call_site": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "line", "method", "template", "parameters"],
          "properties": {
            "file": { "type": "string", "pattern": "^src/backend/.+\\.cs$" },
            "line": { "type": "integer", "minimum": 1 },
            "method": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
            "template": { "type": "string", "maxLength": 300 },
            "parameters": { "type": "array", "maxItems": 10, "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" } }
          }
        }
      ]
    },
    "runbook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor", "path", "text"],
      "properties": {
        "anchor": { "type": "string", "pattern": "^([a-z0-9]+(-[a-z0-9]+)*|t-[0-9a-f]{12})$" },
        "path": { "type": "string", "pattern": "^docs/(areas/[a-z]+(-[a-z]+)*/operations\\.md|support/unkeyed-runbooks\\.md)$" },
        "text": { "type": "string", "maxLength": 8000, "description": "Markdown of the runbook section below its field table" }
      }
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_per_hour"],
      "properties": { "expected_per_hour": { "type": "integer", "minimum": 0 } }
    },
    "fingerprint_by": { "type": "array", "maxItems": 3, "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" } },
    "cause_category": {
      "type": "string",
      "enum": [
        "access", "data_missing", "data_conflict", "dependency_unavailable", "configuration", "capacity",
        "code_defect", "external_input", "expected_behaviour", "unknown"
      ]
    },
    "status": { "type": "string", "enum": ["active", "noise", "fixed"] },
    "fixed_in": { "type": ["string", "null"], "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$" },
    "noise": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["rationale", "expires"],
          "properties": {
            "rationale": { "type": "string", "maxLength": 300 },
            "expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        }
      ]
    },
    "rule_checks": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "arguments", "expect"],
        "properties": {
          "tool": { "type": "string", "pattern": "^[a-z]+(_[a-z]+)*$" },
          "arguments": { "type": "object", "description": "Name to literal or placeholder ({signal.TraceId}, {signal.Properties.Name})" },
          "expect": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "history": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "incident", "outcome", "reference"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "incident": { "type": "string", "pattern": "^INC-\\d{8}-\\d{4}$" },
          "outcome": { "type": "string", "enum": ["fixed", "noise", "reclassified", "duplicate", "wontfix", "unknown_resolved"] },
          "reference": { "type": ["string", "null"], "maxLength": 500 }
        }
      }
    }
  }
}
