# Settings of compose.yaml. Copy this file to .env (git-ignored) and change what you need:
#   cp .env.example .env
#
# The two secrets below are placeholders that make a local run work at once. Anything that is reachable from
# another machine needs its own values. Use no ";", "$" or quotes in them (they go into a connection string).

# ---- SQL Server (container myapp-sqlserver, no host port) ----
# The sa password of the SQL Server container; at least 8 characters with upper case, lower case, digits and a symbol.
MSSQL_SA_PASSWORD=Change-Me-Local-1

# ---- Application ----
# Development: seed data, Swagger, impersonation (the local sign-in below). Production: none of these, and a real
# identity provider is needed (README "Run with Docker").
APP_ENVIRONMENT=Development
APP_DATABASE_NAME=MyApp
# The impersonation works only in Development, whatever this says.
APP_IMPERSONATION=true
# Local sign-in without an identity provider: the seed's admin user. Empty means a real sign-in (Entra).
# It only works when the backend runs in Development with the impersonation on; leave it empty in Production.
VITE_DEV_MOCK_USER_ID=00000000-0000-0000-0000-000000000001
VITE_DEV_MOCK_USER_EMAIL=dev@myapp.local
# Real sign-in (Microsoft Entra External ID); read by the browser at run time, never secrets.
# VITE_AZURE_AD_B2C_CLIENT_ID=
# VITE_AZURE_AD_B2C_AUTHORITY=
# VITE_AZURE_AD_B2C_KNOWN_AUTHORITIES=
# VITE_API_SCOPE=
# VITE_API_AUDIENCE=
# More backend settings (AzureAd__*, ConnectionStrings, ...): one KEY=value line each in backend.local.env (git-ignored,
# optional); it is read by the backend and the E2E backend.

# Where the frontend is published on the host. 127.0.0.1 keeps it on this machine; use 0.0.0.0 to serve the network.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3147

# ---- Monitor (profile "monitor") ----
# HMAC key of the masking, at least 32 bytes.
MONITOR_HASH_KEY=change-me-local-monitor-key-0123456789abcdef
# Dashboard on the host, 127.0.0.1 only.
MONITOR_PORT=5310

# ---- Model hosts (profiles "assistant-model", "investigator-model", "teacher") ----
# The host folder with the model files, mounted read-only at /models. The *_MODEL_FILE paths are relative to it.
# No file is downloaded: without a file the container says so and stops.
# Folder with the model files, outside the repository (models are never committed). The same folder as MYAPP_MODELS_DIR of the
# training scripts (default ~/myapp-models): fetch writes assistant/assistant.gguf and investigator/investigator.gguf there.
MODELS_DIR=~/myapp-models
ASSISTANT_MODEL_FILE=assistant/assistant.gguf
ASSISTANT_MODEL_ALIAS=assistant-0.0.0
INVESTIGATOR_MODEL_FILE=investigator/investigator.gguf
INVESTIGATOR_MODEL_ALIAS=investigator-0.0.0
# The large tier is Qwen3.6-35B-A3B used untrained (4-bit GGUF): once it is recorded, point INVESTIGATOR_MODEL_FILE at its export (models.md 6.1).
# The teacher and judge of the training pipeline: Qwen3.8-27B as a 4-bit GGUF (alternative Qwen3.6-35B-A3B), OpenAI-compatible at
# http://localhost:8093/v1. The alias is the model name in training/assistant/config/dataset.json and eval.json (models.md 5.6).
TEACHER_MODEL_FILE=teacher/Qwen3.8-27B-Q4_K_M.gguf
TEACHER_MODEL_ALIAS=qwen3.8-27b
TEACHER_CTX_SIZE=8192
TEACHER_PARALLEL=1
# auto: the GPU when the container has one (compose.gpu.yaml), else the CPU. cpu forces the CPU.
MODEL_HOST_DEVICE=auto
# Threads of the CPU build; empty means the physical cores seen by the container.
MODEL_HOST_THREADS=

# ---- E2E tests (profile "e2e") ----
# The run's own database on the compose SQL Server. The name must end in _E2E or _Test, or the backend refuses to start.
E2E_DATABASE_NAME=MyApp_E2E
