      "ExceptionType": "code",
      "Job": "code",
      "Language": "code",
      "LogKey": "code",
      "Page": "number",
      "PageSize": "number",
      "Policy": "code",
      "Role": "code",
      "Route": "code",
      "Status": "code",
      "TopFrame": "code",
      "TotalPages": "number",
      "Truncated": "boolean",
      "Url": "free_text",
      "{OriginalFormat}": "free_text"
    }
  },
  "tools": {
    "audit_trail_by_entity": {
      "changes[].timestamp": "timestamp",
      "changes[].action": "code",
      "changes[].user_id": "id",
      "changes[].changed_properties[]": "code",
      "changes[].old_values": "entity",
      "changes[].new_values": "entity",
      "changes[].correlation_id": "id"
    },
    "health_status": {
